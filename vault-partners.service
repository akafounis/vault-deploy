[Unit]
Description=Vault Partners FastAPI App
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/vault-partners
EnvironmentFile=/var/www/vault-partners/.env
ExecStart=/var/www/vault-partners/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
